[Unit]
Description=Agent Notifier shared coding-agent session service
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/agent-notifier serve --codex @CODEX_BINARY@
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Environment="PATH=@SERVICE_PATH@"

[Install]
WantedBy=default.target
